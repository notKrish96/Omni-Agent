{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences, configuration, and state",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "displayName": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "User email address" },
        "wakePhrase": { "type": "string", "description": "Hotword wake phrase e.g. jarvis" },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp" }
      },
      "required": ["userId", "email"]
    },
    "AgentLog": {
      "title": "AgentLog",
      "description": "OmniAgent system execution logs and voice commands",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log ID" },
        "userId": { "type": "string", "description": "User ID" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Log timestamp" },
        "type": { "type": "string", "enum": ["EXECUTION", "SYSTEM", "VOICE", "VISION", "SAFETY_BLOCK"], "description": "Log type" },
        "title": { "type": "string", "description": "Log entry title" },
        "detail": { "type": "string", "description": "Log details" },
        "agent": { "type": "string", "description": "Executing agent name" }
      },
      "required": ["userId", "timestamp", "type", "title"]
    },
    "UserTask": {
      "title": "UserTask",
      "description": "User tasks and reminders created by agent drivers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Task ID" },
        "userId": { "type": "string", "description": "User ID" },
        "title": { "type": "string", "description": "Task title" },
        "completed": { "type": "boolean", "description": "Completion state" },
        "app": { "type": "string", "description": "Associated app driver" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/users/{userId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/AgentLog" },
      "description": "Agent logs per user"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/UserTask" },
      "description": "User tasks per user"
    }
  }
}
